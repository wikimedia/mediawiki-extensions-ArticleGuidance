		"ext.articleguidance.tag.styles": {
			"localBasePath": "resources/ext.articleguidance.tag.styles",
			"remoteExtPath": "ArticleGuidance/resources/ext.articleguidance.tag.styles",
			"styles": [
				"article-guidance.less"
			]
		},
		"ext.articleguidance.newarticle.styles": {
			"localBasePath": "resources/ext.articleguidance.newarticle.styles",
			"remoteExtPath": "ArticleGuidance/resources/ext.articleguidance.newarticle.styles",
			"styles": [
				"styles.less"
			]
		},
		"ext.articleguidance.publishingfollowup": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"localBasePath": "resources/ext.articleguidance.publishingfollowup",
			"remoteExtPath": "ArticleGuidance/resources/ext.articleguidance.publishingfollowup",
			"codexComponents": [
				"CdxButton",
				"CdxIcon"
			],
			"packageFiles": [
				"init.js",
				"connectWikidata.js",
				"instrument.js",
				"PublishFollowUp.vue",
				{
					"name": "config.json",
					"config": [
						"ArticleGuidanceExperimentName",
						"ArticleGuidanceWikidataUrls"
					]
				},
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconClose",
						"cdxIconEdit",
						"cdxIconInfoFilled",
						"cdxIconSuccess"
					]
				}
			],
			"messages": [
				"articleguidance-publish-followup-confirmation-title",
				"articleguidance-publish-followup-community-review",
				"articleguidance-publish-followup-edit-more-button",
				"articleguidance-publish-followup-close-button"
			],
			"dependencies": [
				"vue",
				"mediawiki.ForeignApi"
			]
		},
		"ext.articleguidance.ve": {
			"localBasePath": "resources/ext.articleguidance.ve",
			"remoteExtPath": "ArticleGuidance/resources/ext.articleguidance.ve",
