{
	"name": "ArticleGuidance",
	"author": [
		"Stephane Bisson",
		"Eduardo Medina",
		"Nik Gkountas"
	],
	"url": "https://www.mediawiki.org/wiki/Special:MyLanguage/Extension:ArticleGuidance",
	"descriptionmsg": "articleguidance-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.48.0"
	},
	"suggests": {
		"extensions": {
			"CommunityConfiguration": "*"
		}
	},
	"attributes": {
		"CommunityConfiguration": {
			"Providers": {
				"ArticleGuidance": {
					"store": {
						"type": "wikipage",
						"args": [
							"MediaWiki:ArticleGuidanceConfig.json"
						]
					},
					"validator": {
						"type": "jsonschema",
						"args": [
							"MediaWiki\\Extension\\ArticleGuidance\\Config\\ArticleGuidanceSchema"
						]
					},
					"type": "mw-config",
					"options": {
						"helpPage": "Article_guidance/Community_Configuration"
					}
				}
			}
		}
	},
	"config": {
		"ArticleGuidanceEnabled": {
			"value": false,
			"description": "Master switch for the whole user-facing feature. When false, the wiki behaves as if Article Guidance were not enabled: red links never redirect, Special:NewArticle gives no access to the workflow, the articleguidance-enable preference is hidden, and no analytics event is sent. It has precedence over the more specific settings, such as ArticleGuidanceRedirectEnabled. With the CommunityConfiguration extension installed, this value is the default and MediaWiki:ArticleGuidanceConfig.json overrides it."
		},
		"ArticleGuidanceUserAgent": {
			"value": "MediaWiki/ArticleGuidance language-product-localization@wikimedia.org",
			"description": "User-Agent header sent with server-side HTTP requests to Wikidata APIs (wbgetentities, SPARQL)."
		},
		"ArticleGuidanceJuniorEditorThreshold": {
			"value": 100,
			"description": "Minimum number of edits before a user is no longer considered a junior editor."
		},
		"ArticleGuidanceCrossWikiThreshold": {
			"value": 5,
			"description": "Minimum number of sitelinks required for a Wikidata item to satisfy the crosswiki notability criterion."
		},
		"ArticleGuidanceSourcesThreshold": {
			"value": 2,
			"description": "Minimum number of sources required to proceed past the sources step."
		},
		"ArticleGuidanceMatchViaRules": {
			"value": [
				{
					"superclass": "Q12737077",
					"matchVia": "P106"
				},
				{
					"superclass": "Q16521",
					"matchVia": "P171",
					"exclude": "Q5"
				}
			]
		},
		"ArticleGuidanceOutlinePagePrefix": {
			"value": "Project:Article guidance",
			"description": "Page title prefix for outline pages. The outline builder proposes '<prefix>/<label>' as the page to save an outline to. 'Project:' resolves to the wiki's project namespace."
		},
		"ArticleGuidanceOutlineBuilderSourceApi": {
			"value": "",
			"description": "URL of the api.php of the wiki that the outline builder reads example articles from, e.g. 'https://en.wikipedia.org/w/api.php'. Empty uses the local wiki. Only for development and test wikis, which have no real articles."
		},
		"ArticleGuidanceExcludedItemTypes": {
			"value": [
				"Q4167410",
				"Q13406463",
				"Q14204246",
				"Q56005592",
				"Q4663903",
				"Q87879655",
				"Q16695773",
				"Q15184295",
				"Q18711811",
				"Q11266439",
				"Q115595777",
				"Q11753321",
				"Q26267864",
				"Q17146139",
				"Q108783631",
				"Q19887878",
				"Q19842659",
				"Q111803808",
				"Q36330215",
				"Q112869585",
				"Q116152698",
				"Q20769160",
				"Q110010043",
				"Q97950663",
				"Q4167836",
				"Q23894233",
				"Q15647814",
				"Q24046192",
				"Q59541917",
				"Q56428020",
				"Q30432511",
				"Q106612246",
				"Q13331174",
				"Q20010800",
				"Q15407973",
				"Q67131190",
				"Q125101059",
				"Q125101257",
				"Q30330522",
				"Q111019629",
				"Q20769287"
			],
			"description": "Wikidata Q IDs whose P31 presence causes an item to be excluded from article guidance search results. The defaults are the Wikimedia disambiguation page and list article types, and the types of Wikimedia pages outside the main namespace: project, help, portal, WikiProject, module, template and category pages. The search matches the direct P31 value only, so the defaults also list the subclasses of these types that have 1000 or more items on Wikidata."
		},
		"ArticleGuidanceInstrumentName": {
			"value": "article-guidance",
			"description": "TestKitchen instrument name used to log analytics events. An empty string disables logging. This name does not control who is redirected to Special:NewArticle; use ArticleGuidanceRedirectEnabled for that."
		},
		"ArticleGuidanceRedirectEnabled": {
			"value": false,
			"description": "When true, eligible users are redirected to Special:NewArticle from red links. Users can opt out with the articleguidance-enable preference. When false, all traffic follows the default wiki behaviour. This setting has an effect only when ArticleGuidanceEnabled is true. With the CommunityConfiguration extension installed, this value is the default and MediaWiki:ArticleGuidanceConfig.json overrides it."
		},
		"ArticleGuidanceRedirectRefererTitles": {
			"value": [],
			"description": "Page titles (with optional namespace prefix, e.g. 'Wikipedia:Articles to create') whose red-links are in scope."
		},
		"ArticleGuidanceRedirectRefererCategories": {
			"value": [],
			"description": "Category names (without 'Category:' prefix) whose pages' red-links are in scope."
		},
		"ArticleGuidanceRedirectJuniorEditorsOnly": {
			"value": false,
			"description": "When true, the red-link redirect only admits junior editors: in addition to the createpage permission and not being blocked, the user's edit count must be below ArticleGuidanceJuniorEditorThreshold. Default false admits all eligible logged-in users regardless of edit count. With the CommunityConfiguration extension installed, this value is the default and MediaWiki:ArticleGuidanceConfig.json overrides it."
		},
		"ArticleGuidanceWikidataConnectEnabled": {
			"value": false,
			"description": "When true, a published article is automatically connected to the Wikidata item the user selected, by adding a sitelink. Default false so non-production environments never write to Wikidata."
		},
		"ArticleGuidanceWikidataUrls": {
			"value": {
				"api": "https://www.wikidata.org/w/api.php",
				"view": "https://www.wikidata.org/wiki/$1",
				"sparql": "https://query.wikidata.org/sparql"
			},
			"description": "Wikidata endpoint URLs. In 'view', $1 is the Wikidata item Id (Q id). Client and server share these; only the server SPARQL endpoint can be overridden separately, via ArticleGuidanceSparqlEndpoint."
		},
		"ArticleGuidanceSparqlEndpoint": {
			"value": "https://query.wikidata.org/sparql",
			"description": "SPARQL endpoint URL for server-side Wikidata queries (WikidataInfoFetcher). In production this points at the internal proxy; the browser keeps using the public endpoint from ArticleGuidanceWikidataUrls."
		},
		"ArticleGuidanceCxServerUrl": {
			"value": "https://cxserver.wikimedia.org/v1/mt",
			"description": "Base URL of the cxserver machine-translation endpoint used by the client to translate non-Latin topic-matching queries. The source language, target language, and MinT provider are appended as path segments (/{from}/{to}/MinT)."
		},
		"ArticleGuidanceCxTargetLanguage": {
			"value": "en",
			"description": "Language code that non-Latin topic-matching queries are translated into before searching Wikidata."
		},
		"ArticleGuidanceReferenceRiskEnabled": {
			"value": false,
			"description": "Enable reference-risk check in the sources step."
		},
		"ArticleGuidanceLiftWingBaseUrl": {
			"value": "https://api.wikimedia.org/service/lw/inference/v1/models/",
			"description": "Base URL of the LiftWing models. Production uses the internal endpoint."
		},
		"ArticleGuidanceLiftWingReferenceRiskHostHeader": {
			"value": null,
			"description": "Host header for the reference-risk model, needed with the internal LiftWing endpoint. Null sends none."
		},
		"ArticleGuidanceFeedbackTalkPage": {
			"value": "",
			"description": "Full title of the local talk page that collects Article Guidance feedback, e.g. 'Wikipedia talk:Article Guidance'. Empty falls back to Talk:Article guidance on mediawiki.org."
		},
		"ArticleGuidanceSuggestedArticleTypes": {
