{
	"name": "ArticleGuidance",
	"author": [
		"Stephane Bisson",
		"Eduardo Medina",
		"Nik Gkountas"
	],
	"url": "https://www.mediawiki.org/wiki/Special:MyLanguage/Extension:ArticleGuidance",
	"descriptionmsg": "articleguidance-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.47.0"
	},
	"config": {
		"ArticleGuidanceUserAgent": {
			"value": "MediaWiki/ArticleGuidance language-product-localization@wikimedia.org",
			"description": "User-Agent header sent with server-side HTTP requests to Wikidata APIs (wbgetentities, SPARQL)."
		},
		"ArticleGuidanceJuniorEditorThreshold": {
			"value": 100,
			"description": "Minimum number of edits before a user is no longer considered a junior editor."
		},
		"ArticleGuidanceCrossWikiThreshold": {
			"value": 5,
			"description": "Minimum number of sitelinks required for a Wikidata item to satisfy the crosswiki notability criterion."
		},
		"ArticleGuidanceSourcesThreshold": {
			"value": 2,
			"description": "Minimum number of sources required to proceed past the sources step."
		},
		"ArticleGuidanceMatchViaRules": {
			"value": [
				{
					"superclass": "Q12737077",
					"matchVia": "P106"
				},
				{
					"superclass": "Q16521",
					"matchVia": "P171",
					"exclude": "Q5"
				}
			]
		},
		"ArticleGuidanceExcludedItemTypes": {
			"value": [
				"Q4167410",
				"Q13406463",
				"Q11266439",
				"Q4167836"
			],
			"description": "Wikidata Q IDs whose P31 presence causes an item to be excluded from article guidance search results. Q4167410 is the Wikimedia disambiguation page type."
		},
		"ArticleGuidanceExperimentName": {
			"value": "",
			"description": "TestKitchen experiment name used for A/B traffic splitting. When set, only users assigned to the 'treatment' group are redirected to Special:NewArticle. An empty string disables splitting and redirects all eligible traffic."
		},
		"ArticleGuidanceExperimentRefererTitles": {
			"value": [],
			"description": "Page titles (with optional namespace prefix, e.g. 'Wikipedia:Articles to create') whose red-links are in scope."
		},
		"ArticleGuidanceExperimentRefererCategories": {
			"value": [],
			"description": "Category names (without 'Category:' prefix) whose pages' red-links are in scope."
		},
		"ArticleGuidanceExperimentEntryPointTitles": {
			"value": [],
			"description": "Special page or page titles (e.g. 'Special:ArticleWizard') that act as alternative entry points into Article Guidance: qualifying junior mobile users visiting these pages will be redirected to Special:NewArticle. Empty array disables this redirect."
		},
		"ArticleGuidanceExperimentJuniorEditorsOnly": {
			"value": false,
			"description": "When true, the red-link/entry-point experiment only admits junior editors: in addition to the createpage permission and not being blocked, the user's edit count must be below ArticleGuidanceJuniorEditorThreshold. Default false admits all eligible logged-in users regardless of edit count."
		},
		"ArticleGuidanceWikidataConnectEnabled": {
			"value": false,
			"description": "When true, a published article is automatically connected to the Wikidata item the user selected, by adding a sitelink. Default false so non-production environments never write to Wikidata."
		},
		"ArticleGuidanceWikidataUrls": {
			"value": {
				"api": "https://www.wikidata.org/w/api.php",
				"view": "https://www.wikidata.org/wiki/$1",
				"sparql": "https://query.wikidata.org/sparql"
			},
			"description": "Wikidata endpoint URLs. In 'view', $1 is the Wikidata item Id (Q id). Client and server share these; only the server SPARQL endpoint can be overridden separately, via ArticleGuidanceSparqlEndpoint."
		},
		"ArticleGuidanceSparqlEndpoint": {
			"value": "https://query.wikidata.org/sparql",
			"description": "SPARQL endpoint URL for server-side Wikidata queries (WikidataInfoFetcher). In production this points at the internal proxy; the browser keeps using the public endpoint from ArticleGuidanceWikidataUrls."
		},
		"ArticleGuidanceCxServerUrl": {
			"value": "https://cxserver.wikimedia.org/v1/mt",
			"description": "Base URL of the cxserver machine-translation endpoint used by the client to translate non-Latin topic-matching queries. The source language, target language, and MinT provider are appended as path segments (/{from}/{to}/MinT)."
		},
		"ArticleGuidanceCxTargetLanguage": {
			"value": "en",
			"description": "Language code that non-Latin topic-matching queries are translated into before searching Wikidata."
		},
		"ArticleGuidanceFeedbackTalkPage": {
			"value": "",
			"description": "Full title of the local talk page that collects Article Guidance feedback, e.g. 'Wikipedia talk:Article Guidance'. Empty falls back to Talk:Article guidance on mediawiki.org."
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\ArticleGuidance\\": "src/"
	},
	"TestAutoloadNamespaces": {
		"MediaWiki\\Extension\\ArticleGuidance\\Tests\\Unit\\": "tests/phpunit/unit/"
	},
	"ServiceWiringFiles": [
		"src/ServiceWiring.php"
	],
	"RestRoutes": [
		{
			"path": "/articleguidance/v1/outlines",
			"method": "GET",
			"class": "MediaWiki\\Extension\\ArticleGuidance\\Rest\\ListOutlinesHandler",
			"services": [
				"ArticleGuidanceOutlineService"
			]
		},
		{
			"path": "/articleguidance/v0/outlines",
			"method": "GET",
			"class": "MediaWiki\\Extension\\ArticleGuidance\\Rest\\ListOutlinesHandler",
			"services": [
				"ArticleGuidanceOutlineService"
			]
		},
		{
			"path": "/articleguidance/v0/source/validate",
			"method": "GET",
			"class": "MediaWiki\\Extension\\ArticleGuidance\\Rest\\ValidateSourceHandler",
			"services": [
				"ArticleGuidanceSourceValidator"
			]
		}
	],
	"SpecialPages": {
		"NewArticle": {
			"class": "MediaWiki\\Extension\\ArticleGuidance\\Specials\\SpecialNewArticle",
			"services": [
				"ContentLanguage",
				"MainConfig"
			]
		}
	},
	"HookHandlers": {
		"RedLinkRedirect": {
			"class": "MediaWiki\\Extension\\ArticleGuidance\\Hooks\\RedLinkRedirectHandler",
			"services": [
				"ArticleGuidanceTitleExtractor",
				"MainConfig",
				"TitleFactory",
				"ArticleGuidanceExperimentFactory",
				"UserOptionsLookup",
				"ConnectionProvider"
			]
		},
		"Preferences": {
			"class": "MediaWiki\\Extension\\ArticleGuidance\\Hooks\\PreferencesHandler",
			"services": [
				"ArticleGuidanceExperimentFactory"
			]
		},
		"ArticleGuidanceTag": {
			"class": "MediaWiki\\Extension\\ArticleGuidance\\Hooks\\ArticleGuidanceTagHandler",
			"services": [
				"ArticleGuidanceWikidataInfoFetcher",
				"ArticleGuidanceRenderer",
				"ArticleGuidanceTagContentExtractorService",
				"MainConfig"
			]
		},
		"EditTag": {
			"class": "MediaWiki\\Extension\\ArticleGuidance\\Hooks\\EditTagHandler",
			"services": [
				"ArticleGuidanceExperimentFactory"
			]
		},
		"PreloadCleanup": {
			"class": "MediaWiki\\Extension\\ArticleGuidance\\Hooks\\PreloadCleanupHandler"
		},
		"PublishFollowUp": {
			"class": "MediaWiki\\Extension\\ArticleGuidance\\Hooks\\PublishFollowUpHandler",
			"services": [
				"MainConfig"
			]
		}
	},
	"Hooks": {
		"BeforeInitialize": "RedLinkRedirect",
		"ParserFirstCallInit": "ArticleGuidanceTag",
		"ListDefinedTags": "EditTag",
		"ChangeTagsListActive": "EditTag",
		"RevisionFromEditComplete": "EditTag",
		"EditFormPreloadText": "PreloadCleanup",
		"BeforePageDisplay": "PublishFollowUp",
		"GetPreferences": "Preferences"
	},
	"DefaultUserOptions": {
		"articleguidance-enable": 1
	},
	"ExtensionMessagesFiles": {
		"ArticleGuidanceAlias": "ArticleGuidance.alias.php"
	},
	"MessagesDirs": {
		"ArticleGuidance": [
			"i18n"
		]
	},
	"ResourceModules": {
		"ext.articleguidance.newarticle": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"localBasePath": "resources/ext.articleguidance.newarticle",
			"remoteExtPath": "ArticleGuidance/resources/ext.articleguidance.newarticle",
			"packageFiles": [
				"init.js",
				"stores/useArticleGuidanceStore.js",
				"App.vue",
				"api/MediaWiki.js",
				"api/Outlines.js",
				"api/Sources.js",
				"api/Wikidata.js",
				"api/Sparql.js",
				"api/Citoid.js",
				"api/Cx.js",
				"composables/useArticleExist.js",
				"composables/outlineMatching.js",
				"composables/useSearch.js",
				"composables/useSearchDelayed.js",
				"composables/useWikidataSearch.js",
				"components/StepHeader.vue",
				"components/Step.vue",
				"components/SearchStep.vue",
				"components/Outlines.vue",
				"components/SourcesStep.vue",
				"components/NotabilityStep.vue",
				"components/UnsupportedSubjectStep.vue",
				"components/ActionOption.vue",
				"components/InstructionsStep.vue",
				"components/SubjectCoveredStep.vue",
				"components/TitleConflictStep.vue",
				"components/UpdateTitleStep.vue",
				"components/ArticleInfo.vue",
				"components/ArticleCard.vue",
				"components/StateMessage.vue",
				"utils/md5.js",
				"utils/commonsThumb.js",
				"utils/sources.js",
				"utils/notability.js",
				"utils/draft.js",
				"utils/mobile.js",
				"utils/retry.js",
				"utils/articleUrl.js",
				"utils/citation.js",
				"utils/scroll.js",
				"utils/projectFeedback.js",
				"utils/wikidata.js",
				"utils/script.js",
				"utils/title.js",
				"logging/notability.js",
				"logging/search.js",
				"logging/instrument.js",
				{
					"name": "config.json",
					"config": [
						"ArticleGuidanceExperimentName",
						"ArticleGuidanceWikidataUrls",
						"ArticleGuidanceCxServerUrl",
						"ArticleGuidanceCxTargetLanguage",
						"ArticleGuidanceFeedbackTalkPage"
					]
				},
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconAdd",
						"cdxIconArrowPrevious",
						"cdxIconArticle",
						"cdxIconUserTalk",
						"cdxIconBook",
						"cdxIconClose",
						"cdxIconEdit",
						"cdxIconInfo",
						"cdxIconInfoFilled",
						"cdxIconLinkExternal",
						"cdxIconLogoWikidata",
						"cdxIconSandbox"
					]
				}
			],
			"codexComponents": [
				"CdxAccordion",
				"CdxButton",
				"CdxCard",
				"CdxIcon",
				"CdxInfoChip",
				"CdxMessage",
				"CdxProgressIndicator",
				"CdxTextInput"
			],
			"messages": [
				"articleguidance-specialnewarticle-title",
				"articleguidance-specialnewarticle-title-placeholder",
				"articleguidance-specialnewarticle-loading",
				"articleguidance-specialnewarticle-checking",
				"articleguidance-specialnewarticle-checking-subject",
				"articleguidance-specialnewarticle-checking-subject-delayed",
				"articleguidance-specialnewarticle-no-results",
				"articleguidance-specialnewarticle-search-error",
				"articleguidance-specialnewarticle-search-retry",
				"articleguidance-specialnewarticle-invalid-title",
				"articleguidance-specialnewarticle-invalid-title-generic",
				"articleguidance-specialnewarticle-language-fallback-notice",
				"articleguidance-titleconflict-exists-warning",
				"articleguidance-specialnewarticle-edit-existing",
				"articleguidance-specialnewarticle-disambiguation-title",
				"articleguidance-specialnewarticle-browse-outlines-prefix",
				"articleguidance-specialnewarticle-browse-outlines-link",
				"articleguidance-specialnewarticle-skip-guidance-prefix",
				"articleguidance-specialnewarticle-skip-guidance-link",
				"articleguidance-sources-title",
				"articleguidance-sources-subtitle",
				"articleguidance-sources-subtitle-notability-risk",
				"articleguidance-sources-url-placeholder",
