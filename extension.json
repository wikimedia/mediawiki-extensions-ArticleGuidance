				"articleguidance-sources-tips-content-discouraged",
				"articleguidance-instructions-guidance-heading",
				"articleguidance-instructions-guidance-intro",
				"articleguidance-instructions-start-writing",
				"articleguidance-navigation-back",
				"articleguidance-notability-warning",
